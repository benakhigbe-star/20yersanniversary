# ============================================================================
# Copy this file to .env.local for local development.
# In Vercel, add the same keys under Project Settings → Environment Variables.
# NEVER commit a real .env.local or paste real keys into version control.
# ============================================================================

# --- Supabase --------------------------------------------------------------
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SERVER ONLY. This must never be prefixed with
# NEXT_PUBLIC_ and must never be sent to the browser. It is used exclusively
# inside API routes / server components (see src/lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Session secrets ---------------------------------------------------------
# Two independent, long random secrets (min 32 chars) used to sign guest and
# admin session cookies. Generate with: openssl rand -base64 48
GUEST_SESSION_SECRET=replace-with-a-long-random-string
ADMIN_SESSION_SECRET=replace-with-a-different-long-random-string

# --- Event ------------------------------------------------------------------
# Slug of the event this deployment serves (matches `events.slug`).
NEXT_PUBLIC_EVENT_SLUG=cruise-party-2026

# --- App URL (used for absolute links, e.g. in emails / manifest) -----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
